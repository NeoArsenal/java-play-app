PORT=8080

# En Supabase ve a: Project Settings -> Database -> Connection string -> URI
# Ejemplo Direct Connection (Puerto 5432):
# DATABASE_URL=postgresql://postgres.tu-project-ref:tu-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
# O formato clásico:
# DATABASE_URL=postgresql://postgres:tu-password@db.tu-project-ref.supabase.co:5432/postgres
DATABASE_URL=
